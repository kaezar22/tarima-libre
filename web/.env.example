# Copia como .env.local (no se sube a GitHub). En Vercel: Settings > Environment Variables.

# Firma de la cookie de sesión: una cadena larga y aleatoria (p. ej. `openssl rand -hex 32`)
SESSION_SECRET=

# URL pública (sin / final). En local: http://localhost:3000
NEXT_PUBLIC_BASE_URL=https://tarimalibre.com

# Google Sheets. Sin SPREADSHEET_ID la app usa modo local (.datos_local/).
SPREADSHEET_ID=
# El JSON completo del service account en UNA línea (o en base64)
GOOGLE_SERVICE_ACCOUNT_JSON=

# Fotos (la línea que muestra Cloudinary en API Keys)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Análisis de Instagram (solo texto)
DEEPSEEK_API_KEY=

# Correo para enviar el QR personal (SMTP del proveedor de hello@tarimalibre.com)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=hello@tarimalibre.com
SMTP_PASS=
MAIL_FROM="Tarima Libre <hello@tarimalibre.com>"

# Política de datos
RESPONSABLE_NOMBRE="Tarima Libre"
RESPONSABLE_EMAIL=hello@tarimalibre.com
