# Copia este archivo como .streamlit/secrets.toml (no se sube a GitHub).
# En Streamlit Cloud pega el contenido de cloud_secrets.toml en Settings > Secrets
# (lo genera: python make_cloud_secrets.py).

# ID de la hoja "tarima libre" (lo que va entre /d/ y /edit en la URL).
# Si lo dejas vacío o lo borras, la app trabaja en modo local (_datos_local/).
SPREADSHEET_ID = ""

# Enlace a QR Eventos (menú Herramientas). Opcional.
# QR_EVENTOS_URL = "https://qreventos.streamlit.app/"

# Datos del responsable para la política de datos
RESPONSABLE_NOMBRE = "Hayaku Lab"
RESPONSABLE_EMAIL = "contacto@tudominio.com"

# Análisis de Instagram (solo texto)
DEEPSEEK_API_KEY = "sk-..."

# Fotos de los espacios. Opción A (una línea, la que muestra Cloudinary en API Keys):
# CLOUDINARY_URL = "cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# Opción B (por separado):
[cloudinary]
cloud_name = "..."
api_key = "..."
api_secret = "..."

# OPCIONAL: conectar Instagram con OAuth (cuentas Business/Creator).
# Sin esta sección, el usuario pega su bio y captions a mano.
# redirect_uri debe ser EXACTAMENTE la URL pública de la app (con / final)
# y estar registrada en la app de Meta.
# [instagram]
# app_id = "..."
# app_secret = "..."
# redirect_uri = "https://tarima-libre.streamlit.app/"

# Credenciales del service account. En local basta con dejar
# service_account.json en la raíz del repo (puede ser el mismo de QR Eventos).
